#!@PYTHON@
import glob
import os
import sys


def _package_dir():
    """Locate the directory containing the installed ytdlp_gui package.

    The launcher lives in <prefix>/bin and the package in <prefix>/<libdir>.
    Check the running Python's own lib directory first, then any other Python
    version found under the prefix.
    """
    here = os.path.dirname(os.path.abspath(__file__))
    prefix = os.path.normpath(os.path.join(here, os.pardir))
    version = f"python{sys.version_info.major}.{sys.version_info.minor}"

    candidates = []
    for libdir in ("lib", "lib64"):
        base = os.path.join(prefix, libdir)
        candidates.append(os.path.join(base, version, "site-packages"))
        candidates.append(os.path.join(base, version, "dist-packages"))
        for pattern in ("python*/site-packages", "python*/dist-packages"):
            candidates.extend(sorted(glob.glob(os.path.join(base, pattern))))

    for candidate in candidates:
        if os.path.isdir(os.path.join(candidate, "ytdlp_gui")):
            return candidate
    return None


_pkg = _package_dir()
if _pkg is not None:
    sys.path.insert(0, _pkg)

from ytdlp_gui.__main__ import main  # noqa: E402

sys.exit(main())
